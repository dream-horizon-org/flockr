# Docker Environment Configuration Template
# Copy this file to .env for local development
# Usage: cp env.docker .env

# ===========================
# Application Settings
# ===========================
ENV=docker
TEAM_SUFFIX=
PRIVATE_HOSTED_ZONE=

# ===========================
# PostgreSQL Configuration
# ===========================
POSTGRES_HOST=flockr-postgres
POSTGRES_PORT=5432
POSTGRES_USER=flockr_user
POSTGRES_PASSWORD=flockr_password
POSTGRES_DATABASE=flockr
POSTGRES_DB=flockr

# ===========================
# Application Server
# ===========================
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# ===========================
# Aerospike Configuration
# ===========================
AEROSPIKE_HOST=flockr-aerospike
AEROSPIKE_PORT=3000
AEROSPIKE_NAMESPACE=test
AEROSPIKE_EVENT_LOOP_SIZE=16
AEROSPIKE_MAX_COMMANDS_IN_PROCESS=40
AEROSPIKE_MAX_CONNECTIONS_PER_NODE=700

# ===========================
# JVM Configuration
# ===========================
JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC -XX:MaxGCPauseMillis=200

# ===========================
# Encryption Keys
# ===========================
# Shared with frontend - used to decrypt frontend-encrypted credential values (Layer 1)
# Generate using: java -cp flockr-admin-1.0-fat.jar io.ascend.flockr.admin.util.KeyGenerator
# or use the KeyGenerator utility class
ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY

# Backend-only - used for database storage encryption (Layer 2)
# Generate using: java -cp flockr-admin-1.0-fat.jar io.ascend.flockr.admin.util.KeyGenerator
# or use the KeyGenerator utility class
BACKEND_STORAGE_ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY

