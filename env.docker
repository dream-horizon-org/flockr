# Docker Environment Configuration Template
# Copy this file to .env for local development
# Usage: cp env.docker .env

# ===========================
# Application Settings
# ===========================
ENV=docker
TEAM_SUFFIX=
PRIVATE_HOSTED_ZONE=

# ===========================
# PostgreSQL Configuration
# ===========================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=flockr_user
POSTGRES_PASSWORD=flockr_password
POSTGRES_DATABASE=flockr
POSTGRES_DB=flockr

# ===========================
# Flink Configuration
# ===========================
FLINK_HOST=flink-jobmanager
FLINK_PORT=8081
FLINK_CONNECT_TIMEOUT=30000
FLINK_REQUEST_TIMEOUT=60000
FLINK_MAX_POOL_SIZE=16
FLINK_LOG_ACTIVITY=true
FLINK_KEEP_ALIVE=true
FLINK_KEEP_ALIVE_TIMEOUT=60
FLINK_SAVEPOINT_POLL_INTERVAL=2000
FLINK_SAVEPOINT_MAX_RETRIES=30

# ===========================
# Spark Configuration
# ===========================
SPARK_MASTER_URL=spark://spark-master:7077

# ===========================
# Application Server
# ===========================
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# ===========================
# Aerospike Configuration
# ===========================
AEROSPIKE_HOST=aerospike
AEROSPIKE_PORT=3000
AEROSPIKE_NAMESPACE=test
AEROSPIKE_EVENT_LOOP_SIZE=16
AEROSPIKE_MAX_COMMANDS_IN_PROCESS=40
AEROSPIKE_MAX_CONNECTIONS_PER_NODE=700

# ===========================
# JVM Configuration
# ===========================
JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC -XX:MaxGCPauseMillis=200

