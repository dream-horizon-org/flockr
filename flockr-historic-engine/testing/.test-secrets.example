# Test Secrets Configuration
# Copy this file to .test-secrets and fill in your actual credentials
# The .test-secrets file is gitignored and will not be committed

# AWS Credentials (will replace test_access_key, test_secret_key, test_session_token placeholders)
export TEST_ACCESS_KEY="your-aws-access-key-here"
export TEST_SECRET_KEY="your-aws-secret-key-here"
export TEST_SESSION_TOKEN="your-aws-session-token-here"

# Optional: Encryption key for decrypting encrypted credentials
# export ENCRYPTION_KEY="your-encryption-key-here"

